<!--
    themes.xml - Tema XML aplikasi (hanya "cangkang").

    Kenapa masih perlu XML theme padahal UI sepenuhnya Compose?
    Karena Android tetap butuh tema window utk fase sebelum Compose render
    (splash awal, status bar). Warna dan gaya konten kita serahkan ke
    MaterialTheme di Theme.kt (Compose), jadi XML ini sengaja minimal.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Parent NoActionBar: hapus action bar klasik sistem karena judul
         digambar sendiri oleh TopAppBar Compose. -->
    <style name="Theme.HuaweiEcosystem" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Transparan agar enableEdgeToEdge() bisa menampilkan konten
             menembus status bar (efek modern fullscreen). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
